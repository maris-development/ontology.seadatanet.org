<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <!-- 1 – Default document (unchanged) -->
    <defaultDocument enabled="true">
      <files>
        <clear/>
        <add value="index-en.html" />
      </files>
    </defaultDocument>

    <!-- 2 – Extra MIME types (AddType in Apache) -->
    <staticContent>
        <!-- 1) Remove any parent-defined mappings -->
        <remove fileExtension=".rdf" />
        <remove fileExtension=".owl" />
        <remove fileExtension=".ttl" />
        <remove fileExtension=".n3" />
        <remove fileExtension=".jsonld" />

        <!-- 2) Add your custom mappings -->
        <mimeMap fileExtension=".rdf"    mimeType="application/rdf+xml" />
        <mimeMap fileExtension=".owl"    mimeType="application/rdf+xml" />
        <mimeMap fileExtension=".ttl"    mimeType="text/turtle" />
        <mimeMap fileExtension=".n3"     mimeType="application/n-triples" />
        <mimeMap fileExtension=".jsonld" mimeType="application/ld+json" />
    </staticContent>


    <!-- 3 – Content-negotiation rules (RewriteEngine section) -->
    <rewrite>
      <rules>

        <!-- 3.1  JSON-LD preferred -->
        <rule name="Root → JSON-LD" stopProcessing="true">
          <match url="^$" />
          <conditions>
            <add input="{HTTP_ACCEPT}" pattern="application/ld\+json" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="ontology.jsonld" redirectType="SeeOther" />
        </rule>

        <!-- 3.2  Human-readable HTML/XHTML -->
        <rule name="Root → HTML" stopProcessing="true">
          <match url="^$" />
          <!-- any of these will satisfy the rule -->
          <conditions logicalGrouping="MatchAny">
            <add input="{HTTP_ACCEPT}"   pattern="text/html"            ignoreCase="true" />
            <add input="{HTTP_ACCEPT}"   pattern="application/xhtml\+xml" ignoreCase="true" />
            <add input="{HTTP_USER_AGENT}" pattern="^Mozilla/.*"        ignoreCase="true" />
          </conditions>
          <!-- Mirrors the original 303 behaviour -->
          <action type="Rewrite" url="index-en.html" redirectType="SeeOther" />
        </rule>

        <!-- 3.3  RDF/XML -->
        <rule name="Root → RDF/XML" stopProcessing="true">
          <match url="^$" />
          <conditions logicalGrouping="MatchAny">
            <add input="{HTTP_ACCEPT}" pattern="application/rdf\+xml" ignoreCase="true" />
            <add input="{HTTP_ACCEPT}" pattern="\*/\*"                ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="ontology.owl" redirectType="SeeOther" />
        </rule>

        <!-- 3.4  N-Triples -->
        <rule name="Root → N-Triples" stopProcessing="true">
          <match url="^$" />
          <conditions>
            <add input="{HTTP_ACCEPT}" pattern="application/n-triples" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="ontology.nt" redirectType="SeeOther" />
        </rule>

        <!-- 3.5  Turtle -->
        <rule name="Root → Turtle" stopProcessing="true">
          <match url="^$" />
          <conditions logicalGrouping="MatchAny">
            <add input="{HTTP_ACCEPT}" pattern="text/turtle" ignoreCase="true" />
            <add input="{HTTP_ACCEPT}" pattern="text/\*"     ignoreCase="true" />
            <add input="{HTTP_ACCEPT}" pattern="\*/turtle"   ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="ontology.ttl" redirectType="SeeOther" />
        </rule>

        <!-- 3.6  Nothing matched → 406 Not Acceptable -->
        <rule name="Root → 406" stopProcessing="true">
          <match url="^$" />
          <conditions>
            <add input="{HTTP_ACCEPT}" pattern=".+"/>
          </conditions>
          <!-- “CustomResponse” keeps the 406 status while serving your file -->
          <action type="CustomResponse" statusCode="406" statusReason="Not Acceptable"
                  subStatusCode="0" url="406.html" />
        </rule>

        <!-- 3.7  Absolute fall-back (no Accept header) -->
        <rule name="Root → RDF/XML default" stopProcessing="true">
          <match url="^$" />
          <action type="Redirect" url="ontology.owl" redirectType="SeeOther" />
        </rule>

      </rules>
    </rewrite>

    <!-- 4 – “Options -MultiViews” has no IIS equivalent; nothing to do. -->

  </system.webServer>
</configuration>
